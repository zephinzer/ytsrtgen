{
    "swagger": "2.0",
    "info": {
        "description": "Fetches auto-generated English SRT subtitles for a video URL via yt-dlp.",
        "title": "ytsrtgen API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/": {
            "post": {
                "description": "Runs yt-dlp against the supplied URL and returns the resulting English SRT subtitles.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Generate SRT for a video URL",
                "parameters": [
                    {
                        "description": "Video URL",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.request"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.response"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/main.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/main.errorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.errorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "main.request": {
            "type": "object",
            "properties": {
                "data": {
                    "description": "Data is the video URL to fetch subtitles for.",
                    "type": "string",
                    "example": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
                }
            }
        },
        "main.response": {
            "type": "object",
            "properties": {
                "srt": {
                    "description": "Srt is the SRT-formatted subtitle content.",
                    "type": "string"
                }
            }
        }
    }
}